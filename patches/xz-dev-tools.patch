+// ---------------------------------------------------------------------------------------------
+void XzDevStart() {
+#if CONFIG_XZ_DEV_SERIAL_SCREENSHOT
+    ESP_LOGI(TAG, "serial screenshots enabled: first after %d ms, then every %d ms, count %d (0 = forever)",
+             CONFIG_XZ_DEV_SCREENSHOT_FIRST_MS, CONFIG_XZ_DEV_SCREENSHOT_PERIOD_MS, CONFIG_XZ_DEV_SCREENSHOT_COUNT);
+    // Lowest application priority: it must never get in the way of audio or UI.
+    xTaskCreate(ScreenshotTask, "xz_dev_shot", 16384, nullptr, 1, nullptr);
+#endif
+#if CONFIG_XZ_DEV_FACE_DEMO && !CONFIG_USE_EMOTE_MESSAGE_STYLE
+    ESP_LOGI(TAG, "face demo enabled: first after %d ms, then every %d ms while offline",
+             CONFIG_XZ_DEV_FACE_DEMO_FIRST_MS, CONFIG_XZ_DEV_FACE_DEMO_PERIOD_MS);
+    xTaskCreate(FaceDemoTask, "xz_dev_face", 8192, nullptr, 1, nullptr);
+#endif
+#if CONFIG_XZ_DEV_NAME_DEMO
+    ESP_LOGI(TAG, "name demo enabled: \"%s\" while the device is starting (offline)", CONFIG_XZ_DEV_NAME_TEXT);
+    xTaskCreate(NameDemoTask, "xz_dev_name", 8192, nullptr, 1, nullptr);
+#endif
+}
